PORT=3000
NODE_ENV=development

# OpenAI: API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Google Gemini: API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash

# Generate a long random secret (at least 32 characters)
JWT_SECRET=replace-this-with-a-long-random-secret-string

# Optional: users registering with this email get admin role.
# Set before registering your own account. Keep this private.
ADMIN_EMAIL=owner@example.com
ADMIN_SETUP_TOKEN=replace-with-a-second-long-private-admin-token

# Free limits per user per UTC day
DAILY_CHAT_LIMIT=25
DAILY_IMAGE_LIMIT=2
